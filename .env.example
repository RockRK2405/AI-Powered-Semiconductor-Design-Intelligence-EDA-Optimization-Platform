# Copy to .env and adjust. Never commit .env.
# Root directory for runs, database and datasets (default: ./workspace)
SILICONAI_HOME=./workspace
# Docker image providing OpenROAD-flow-scripts (pin a digest for reproducibility)
SILICONAI_ORFS_IMAGE=openroad/orfs:latest
# Default per-command timeout in seconds
SILICONAI_TOOL_TIMEOUT_S=7200
# Logging level: DEBUG, INFO, WARNING, ERROR
SILICONAI_LOG_LEVEL=INFO
